# Copy to .env for local development. Production values live in the host's settings, never in git.

# PostgreSQL connection
DATABASE_URL="postgresql://polyra:polyra@localhost:5432/polyra_local"
# Separate database for automated tests (wiped by the test setup)
TEST_DATABASE_URL="postgresql://polyra:polyra@localhost:5432/polyra_test"
# Optional: a separate database for the browser tests (defaults to TEST_DATABASE_URL)
# E2E_DATABASE_URL="postgresql://polyra:polyra@localhost:5432/polyra_e2e"

# "mock" sends nothing and shows codes on screen and on the test-codes page.
# "kavenegar" sends real SMS through a Kavenegar verify template with one %token.
SMS_PROVIDER="mock"
# SMS_API_KEY=""
# SMS_TEMPLATE=""

# Secret for HMAC of phone numbers in trial_ledger (PRD §4.3). Long random string in production.
PHONE_HASH_SECRET="change-me"

# Secret for hashing SMS login codes. Long random string in production.
AUTH_SECRET="change-me"

# Where uploaded audio is stored (on the server: a mounted disk at /app/storage)
STORAGE_DIR="./storage"

# Staging only: when set, every page asks for this password first (any user name)
# SITE_PASSWORD=""

# Server only: the first admin and tester accounts made at start-up (in development, fixed test numbers)
# SEED_ADMIN_PHONE=""
# SEED_TESTER_PHONE=""

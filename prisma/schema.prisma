model ReviewLog {
  /// The answer_id the client creates (PRD §15.4).
  id                 String        @id @db.Uuid
  /// Emptied when the account is deleted; the row stays anonymous.
  user_id            Int?
  language           String        @db.VarChar(8)
  session_id         String?       @db.Uuid
  kind               ReviewKind
  item_type          String?
  item_id            Int?
  exercise_code      String?
  step_before        Int?
  step_after         Int?
  sentence_id        Int?
  sentence_target_id Int?
  question_id        Int?
  question_set       QuestionSet?
  result             ReviewResult
  result_reason      ResultReason?
  raw_answer         String?
  chosen_word_id     Int?
  first_typing       Boolean       @default(false)
  latency_ms         Int?
  fsrs_rating        Int?
  seq                Int?
  ts                 DateTime      @default(now()) @db.Timestamptz(3)

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([user_id, language, ts])
  @@index([session_id, seq])
  @@index([item_type, item_id])
  @@map("review_log")
}


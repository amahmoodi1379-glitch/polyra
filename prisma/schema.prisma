// Polyra data model. Source of truth: docs/PRD.md §4.
// Table and column names follow §4 exactly; models are PascalCase and mapped to those tables.
// Every column that §4 does not list is recorded in DECISIONS.md with the PRD section that needs it.
// Times are stored in UTC (timestamptz). Tehran calendar days use the date type (PRD §15.6).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Value lists
// ─────────────────────────────────────────────────────────────────────────────

enum ContentStatus {
  draft
  needs_review
  approved
  published
  retired

  @@map("content_status")
}

enum Pos {
  noun
  verb
  adj
  adv
  prep
  pron
  det
  conj
  num
  interj
  phrase

  @@map("pos")
}

/// French: m, f, mf. German: der, die, das (PRD §5.1).
enum Gender {
  m
  f
  mf
  der
  die
  das

  @@map("gender")
}

enum GrammaticalNumber {
  sg
  pl_only

  @@map("grammatical_number")
}

enum Register {
  standard
  familier
  argot
  formal

  @@map("register")
}

enum Mastery {
  produce
  recognize

  @@map("mastery")
}

enum TokenKind {
  word
  name
  number
  other

  @@map("token_kind")
}

/// Why a sentence_word row waits for the admin (PRD §13.3, §13.9).
enum CandidateReason {
  /// kind = word and the code is not in the vocabulary
  missing
  /// kind = name but the surface equals a vocabulary lemma or plural
  name_matches_word

  @@map("candidate_reason")
}

enum TargetType {
  word
  grammar

  @@map("target_type")
}

enum Track {
  reading
  listening

  @@map("track")
}

enum QuestionSet {
  A
  B

  @@map("question_set")
}

enum QuestionType {
  mcq
  tf
  order
  match
  cloze
  find
  ctx
  num
  dict

  @@map("question_type")
}

enum PhonicsKind {
  contrast
  rule
  liaison

  @@map("phonics_kind")
}

enum MediaType {
  audio
  video

  @@map("media_type")
}

enum AudioKind {
  word
  sentence
  text
  phonics
  dialogue

  @@map("audio_kind")
}

enum AudioSource {
  tts
  human

  @@map("audio_source")
}

enum PromptKind {
  P_C  @map("P-C")
  P_U  @map("P-U")
  P_W  @map("P-W")
  P_S  @map("P-S")
  P_F  @map("P-F")
  P_G  @map("P-G")
  P_T  @map("P-T")
  P_X  @map("P-X")
  P_H  @map("P-H")
  P_TR @map("P-TR")
  P_D  @map("P-D")
  P_E  @map("P-E")
  P_WR @map("P-WR")
  P_QA @map("P-QA")

  @@map("prompt_kind")
}

enum ImportState {
  prompt_made
  pasted
  imported
  qa_done
  reviewed

  @@map("import_state")
}

enum OtpPurpose {
  login
  change_phone

  @@map("otp_purpose")
}

enum StartMode {
  zero
  placement

  @@map("start_mode")
}

enum PaceMode {
  normal
  slow

  @@map("pace_mode")
}

enum Skill {
  vocab
  grammar
  listening
  reading

  @@map("skill")
}

enum ItemType {
  word
  grammar_unit
  conjugation

  @@map("item_type")
}

enum Probation {
  none
  single
  sample

  @@map("probation")
}

enum ItemSource {
  normal
  tap
  key_word
  colloquial
  i_know
  pretest
  placement

  @@map("item_source")
}

enum NotebookRefType {
  word
  word_gender
  conjugation
  grammar_target

  @@map("notebook_ref_type")
}

enum QueueSource {
  tap
  key_word
  colloquial

  @@map("queue_source")
}

enum SessionScope {
  mixed
  quick
  vocab
  grammar
  listening
  reading
  notebook
  phonics
  writing
  extra

  @@map("session_scope")
}

enum SessionEndReason {
  finished
  expired
  replaced

  @@map("session_end_reason")
}

enum ReviewKind {
  intro
  pretest
  review
  followup
  practice
  drill
  text_attempt
  phonics
  placement
  exam
  self
  dialogue
  errorfix

  @@map("review_kind")
}

enum ReviewResult {
  correct
  near
  wrong
  idk
  self_ok
  self_near
  self_no

  @@map("review_result")
}

enum ResultReason {
  accent
  case
  gender
  typo

  @@map("result_reason")
}

enum ReportReason {
  my_answer_ok
  answer_wrong
  audio
  translation
  other

  @@map("report_reason")
}

enum ReportPriority {
  normal
  high

  @@map("report_priority")
}

enum ReportStatus {
  open
  fixed
  rejected

  @@map("report_status")
}

enum NoticeKind {
  report_fixed

  @@map("notice_kind")
}

enum OrderStatus {
  pending
  paid
  failed
  expired

  @@map("order_status")
}

enum SubscriptionSource {
  payment
  manual

  @@map("subscription_source")
}

/// percent: value is 1..100. amount: value is a fixed discount in toman (PRD §12.3).
enum DiscountType {
  percent
  amount

  @@map("discount_type")
}

// ─────────────────────────────────────────────────────────────────────────────
// §4.1 Content
// Authored content carries the common fields: id, language, status, suspended,
// prompt_version, model_name, import_batch_id, module_code, created_at, updated_at.
// ─────────────────────────────────────────────────────────────────────────────

model Language {
  code               String  @id @db.VarChar(8)
  live               Boolean @default(false)
  coming_soon_fa     String?
  support_contact_fa String?

  @@map("language")
}

model LevelRelease {
  id          Int      @id @default(autoincrement())
  language    String   @db.VarChar(8)
  level       String   @db.VarChar(8)
  released_at DateTime @default(now()) @db.Timestamptz(3)
  released_by Int?

  @@unique([language, level])
  @@map("level_release")
}

model Concept {
  id              Int           @id @default(autoincrement())
  language        String        @db.VarChar(8)
  status          ContentStatus @default(draft)
  suspended       Boolean       @default(false)
  prompt_version  String?
  model_name      String?
  import_batch_id Int?
  module_code     String?
  created_at      DateTime      @default(now()) @db.Timestamptz(3)
  updated_at      DateTime      @updatedAt @db.Timestamptz(3)

  name_fa String

  words Word[]

  @@unique([language, name_fa])
  @@map("concept")
}

model Word {
  id              Int           @id @default(autoincrement())
  language        String        @db.VarChar(8)
  status          ContentStatus @default(draft)
  suspended       Boolean       @default(false)
  prompt_version  String?
  model_name      String?
  import_batch_id Int?
  module_code     String?
  created_at      DateTime      @default(now()) @db.Timestamptz(3)
  updated_at      DateTime      @updatedAt @db.Timestamptz(3)

  code           String
  lemma          String
  pos            Pos
  gender         Gender?
  number         GrammaticalNumber?
  plural         String?
  register       Register           @default(standard)
  concept_id     Int?
  /// Empty only for draft skeletons made from a word list (PRD §13.9).
  meaning_fa     String?
  level          String             @db.VarChar(8)
  intro_order    Int?
  no_card        Boolean            @default(false)
  mastery        Mastery            @default(produce)
  /// Code of the base word when this entry is a new sense of it (PRD §5.1).
  sense_of       String?
  /// Codes of the words a phrase is made of (pos = phrase only).
  parts          String[]
  /// Lemmas of words that sound exactly the same.
  homophones     String[]
  image          String?
  audio_id       Int?
  human_audio_id Int?
  note_fa        String?
  frequency_rank Int?

  // Not in §4; required by other sections (see DECISIONS.md).
  /// Closed family label such as couleur or Farbe (PRD §5.1, §5.8).
  family            String?
  /// Up to three {text, translation_fa} pairs (PRD §5.1, §5.2).
  collocations      Json?
  /// The chatbot's produce/recognize suggestion, kept for comparison (PRD §13.4).
  mastery_suggested Mastery?
  /// The teacher changed mastery by hand; rank-based defaults no longer touch it (PRD §13.4).
  mastery_manual    Boolean  @default(false)
  /// Imported with a lemma that already exists; waits for "new sense" or "duplicate" (PRD §13.9).
  dup_of_id         Int?

  concept            Concept?           @relation(fields: [concept_id], references: [id])
  sentence_words     SentenceWord[]
  form_exceptions    FormException[]
  conjugation_tables ConjugationTable[]

  @@unique([language, code])
  @@index([language, lemma])
  @@index([language, level, intro_order])
  @@index([language, status])
  @@map("word")
}

model ConjugationTable {
  id              Int           @id @default(autoincrement())
  language        String        @db.VarChar(8)
  status          ContentStatus @default(draft)
  suspended       Boolean       @default(false)
  prompt_version  String?
  model_name      String?
  import_batch_id Int?
  module_code     String?
  created_at      DateTime      @default(now()) @db.Timestamptz(3)
  updated_at      DateTime      @updatedAt @db.Timestamptz(3)

  word_id           Int
  tense             String
  unit_code         String?
  /// Pronoun key to form, e.g. {"je": "vais", ...} (PRD §14.4).
  forms             Json
  accepted_variants Json    @default("{}")
  review_card       Boolean @default(false)

  word Word @relation(fields: [word_id], references: [id])

  @@unique([word_id, tense])
  @@index([language, status])
  @@map("conjugation_table")
}

model Sentence {
  id              Int           @id @default(autoincrement())
  language        String        @db.VarChar(8)
  status          ContentStatus @default(draft)
  suspended       Boolean       @default(false)
  prompt_version  String?
  model_name      String?
  import_batch_id Int?
  module_code     String?
  created_at      DateTime      @default(now()) @db.Timestamptz(3)
  updated_at      DateTime      @updatedAt @db.Timestamptz(3)

  text           String
  tts_text       String?
  translation_fa String
  audio_id       Int?
  human_audio_id Int?
  /// Highest level among the sentence's words; computed on import and edit.
  level          String? @db.VarChar(8)
  text_hash      String

  words   SentenceWord[]
  targets SentenceTarget[]

  @@unique([language, text_hash])
  @@index([language, status])
  @@map("sentence")
}

model SentenceWord {
  id             Int       @id @default(autoincrement())
  sentence_id    Int
  kind           TokenKind @default(word)
  /// Empty for kind = word means a candidate.
  word_id        Int?
  surface        String
  /// Character ranges [[start, end], ...] in sentence.text; several for split phrases.
  spans          Json
  meaning_fa_ctx String?
  suspect        Boolean   @default(false)

  // Not in §4; required by §13.3 and §13.9 (see DECISIONS.md).
  /// Token order in the sentence, starting at 0.
  position         Int
  /// The code the chatbot gave, kept so a candidate can become a draft word.
  code_given       String?
  candidate_reason CandidateReason?

  sentence Sentence @relation(fields: [sentence_id], references: [id], onDelete: Cascade)
  word     Word?    @relation(fields: [word_id], references: [id])

  @@unique([sentence_id, position])
  @@index([word_id])
  @@map("sentence_word")
}

model FormException {
  id         Int      @id @default(autoincrement())
  surface    String
  word_id    Int
  created_at DateTime @default(now()) @db.Timestamptz(3)

  word Word @relation(fields: [word_id], references: [id], onDelete: Cascade)

  @@unique([word_id, surface])
  @@map("form_exception")
}

model SentenceTarget {
  id              Int           @id @default(autoincrement())
  language        String        @db.VarChar(8)
  status          ContentStatus @default(draft)
  suspended       Boolean       @default(false)
  prompt_version  String?
  model_name      String?
  import_batch_id Int?
  module_code     String?
  created_at      DateTime      @default(now()) @db.Timestamptz(3)
  updated_at      DateTime      @updatedAt @db.Timestamptz(3)

  sentence_id   Int
  target_type   TargetType
  /// word.id or grammar_unit.id depending on target_type.
  target_id     Int
  marked_text   String
  blanks        Int        @default(1)
  accepted      Json
  distractors   Json
  hint          String?
  accepted_full Json?

  sentence Sentence @relation(fields: [sentence_id], references: [id], onDelete: Cascade)

  @@index([target_type, target_id])
  @@index([sentence_id])
  @@index([language, status])
  @@map("sentence_target")
}

model GrammarUnit {
  id              Int           @id @default(autoincrement())
  language        String        @db.VarChar(8)
  status          ContentStatus @default(draft)
  suspended       Boolean       @default(false)
  prompt_version  String?
  model_name      String?
  import_batch_id Int?
  module_code     String?
  created_at      DateTime      @default(now()) @db.Timestamptz(3)
  updated_at      DateTime      @updatedAt @db.Timestamptz(3)

  unit_code            String  @unique
  order_no             Int?
  title_fa             String
  scope_fa             String?
  can_do_fa            String?
  level                String  @db.VarChar(8)
  lesson_fa            String?
  build_table          Json?
  example_sentence_ids Int[]
  rule_line_fa         String?
  common_mistake_fa    String?
  category_sets        Json?

  transform_items TransformItem[]
  translate_items TranslateItem[]

  @@index([language, level, order_no])
  @@index([language, status])
  @@map("grammar_unit")
}

model TransformItem {
  id              Int           @id @default(autoincrement())
  language        String        @db.VarChar(8)
  status          ContentStatus @default(draft)
  suspended       Boolean       @default(false)
  prompt_version  String?
  model_name      String?
  import_batch_id Int?
  module_code     String?
  created_at      DateTime      @default(now()) @db.Timestamptz(3)
  updated_at      DateTime      @updatedAt @db.Timestamptz(3)

  grammar_unit_id  Int
  instruction_fa   String
  source_sentence  String
  accepted_outputs String[]

  grammar_unit GrammarUnit @relation(fields: [grammar_unit_id], references: [id], onDelete: Cascade)

  @@index([grammar_unit_id])
  @@map("transform_item")
}

model TranslateItem {
  id              Int           @id @default(autoincrement())
  language        String        @db.VarChar(8)
  status          ContentStatus @default(draft)
  suspended       Boolean       @default(false)
  prompt_version  String?
  model_name      String?
  import_batch_id Int?
  module_code     String?
  created_at      DateTime      @default(now()) @db.Timestamptz(3)
  updated_at      DateTime      @updatedAt @db.Timestamptz(3)

  grammar_unit_id  Int
  prompt_fa        String
  accepted_outputs String[]
  /// Token mapping of the first accepted output (PRD §8b.3).
  tokens           Json

  grammar_unit GrammarUnit @relation(fields: [grammar_unit_id], references: [id], onDelete: Cascade)

  @@index([grammar_unit_id])
  @@map("translate_item")
}

model Text {
  id              Int           @id @default(autoincrement())
  language        String        @db.VarChar(8)
  status          ContentStatus @default(draft)
  suspended       Boolean       @default(false)
  prompt_version  String?
  model_name      String?
  import_batch_id Int?
  module_code     String?
  created_at      DateTime      @default(now()) @db.Timestamptz(3)
  updated_at      DateTime      @updatedAt @db.Timestamptz(3)

  code                      String
  level                     String    @db.VarChar(8)
  band                      Int
  kind                      String
  title                     String
  sentence_ids              Int[]
  speakers                  Json?
  media_type                MediaType @default(audio)
  video_url                 String?
  audio_id                  Int?
  sentence_offsets_ms       Int[]
  human_audio_id            Int?
  human_sentence_offsets_ms Int[]
  duration_sec              Float?
  word_count                Int?
  key_word_ids              Int[]
  placement_ok              Boolean   @default(false)
  difficulty_score          Float?
  order_override            Int?

  questions Question[]

  @@unique([language, code])
  @@index([language, level])
  @@index([language, status])
  @@map("text")
}

model Question {
  id              Int           @id @default(autoincrement())
  language        String        @db.VarChar(8)
  status          ContentStatus @default(draft)
  suspended       Boolean       @default(false)
  prompt_version  String?
  model_name      String?
  import_batch_id Int?
  module_code     String?
  created_at      DateTime      @default(now()) @db.Timestamptz(3)
  updated_at      DateTime      @updatedAt @db.Timestamptz(3)

  text_id        Int
  track          Track
  set            QuestionSet
  order_no       Int
  type           QuestionType
  payload        Json
  explanation_fa String?

  text Text @relation(fields: [text_id], references: [id], onDelete: Cascade)

  @@index([text_id, track, set, order_no])
  @@map("question")
}

model Dialogue {
  id              Int           @id @default(autoincrement())
  language        String        @db.VarChar(8)
  status          ContentStatus @default(draft)
  suspended       Boolean       @default(false)
  prompt_version  String?
  model_name      String?
  import_batch_id Int?
  module_code     String?
  created_at      DateTime      @default(now()) @db.Timestamptz(3)
  updated_at      DateTime      @updatedAt @db.Timestamptz(3)

  code         String
  level        String @db.VarChar(8)
  title_fa     String
  situation_fa String
  /// [{sentence_id, choices: [{sentence_id}], correct, why_fa}] (PRD §8b.4).
  turns        Json

  @@unique([language, code])
  @@index([language, level])
  @@map("dialogue")
}

model ErrorfixItem {
  id              Int           @id @default(autoincrement())
  language        String        @db.VarChar(8)
  status          ContentStatus @default(draft)
  suspended       Boolean       @default(false)
  prompt_version  String?
  model_name      String?
  import_batch_id Int?
  module_code     String?
  created_at      DateTime      @default(now()) @db.Timestamptz(3)
  updated_at      DateTime      @updatedAt @db.Timestamptz(3)

  level          String   @db.VarChar(8)
  marked_text    String
  translation_fa String
  unit_codes     String[]
  errors         Json

  // Not in §4; §14.4 imports it (see DECISIONS.md).
  /// Token mapping of the corrected text.
  tokens Json?

  @@index([language, level])
  @@map("errorfix_item")
}

model WritingTask {
  id              Int           @id @default(autoincrement())
  language        String        @db.VarChar(8)
  status          ContentStatus @default(draft)
  suspended       Boolean       @default(false)
  prompt_version  String?
  model_name      String?
  import_batch_id Int?
  module_code     String?
  created_at      DateTime      @default(now()) @db.Timestamptz(3)
  updated_at      DateTime      @updatedAt @db.Timestamptz(3)

  level           String   @db.VarChar(8)
  prompt_fa       String
  min_words       Int
  max_words       Int
  checklist_fa    String[]
  useful_phrases  Json
  model_answer    String
  model_answer_fa String

  @@index([language, level])
  @@map("writing_task")
}

model Module {
  id       Int     @id @default(autoincrement())
  code     String  @unique
  language String  @db.VarChar(8)
  name_fa  String
  separate Boolean @default(false)

  @@map("module")
}

model PhonicsLesson {
  id              Int           @id @default(autoincrement())
  language        String        @db.VarChar(8)
  status          ContentStatus @default(draft)
  suspended       Boolean       @default(false)
  prompt_version  String?
  model_name      String?
  import_batch_id Int?
  module_code     String?
  created_at      DateTime      @default(now()) @db.Timestamptz(3)
  updated_at      DateTime      @updatedAt @db.Timestamptz(3)

  order_no          Int?
  kind              PhonicsKind
  sound_label       String
  graphemes         String[]
  tip_fa            String
  /// Each word: {text, meaning_fa, wrong_spellings[2], audio_id, human_audio_id}.
  example_words     Json        @default("[]")
  /// Each pair: {a, b, a_fa, b_fa, a_audio_id, b_audio_id, ...}.
  minimal_pairs     Json        @default("[]")
  /// Each sentence: {text, liaison_after_word_index[], audio_id, human_audio_id}.
  liaison_sentences Json        @default("[]")

  @@index([language, order_no])
  @@map("phonics_lesson")
}

model AudioAsset {
  id          Int         @id @default(autoincrement())
  kind        AudioKind
  url         String
  source      AudioSource
  voice       String?
  duration_ms Int?
  stale       Boolean     @default(false)
  uploaded_by Int?
  listened_by Int?
  listened_at DateTime?   @db.Timestamptz(3)
  created_at  DateTime    @default(now()) @db.Timestamptz(3)

  @@map("audio_asset")
}

model FrequencyItem {
  id               Int    @id @default(autoincrement())
  language         String @db.VarChar(8)
  rank             Int
  lemma            String
  used_in_batch_id Int?

  @@unique([language, rank])
  @@index([language, lemma])
  @@map("frequency_item")
}

model ImportBatch {
  id             Int         @id @default(autoincrement())
  language       String      @db.VarChar(8)
  prompt_kind    PromptKind
  prompt_version String
  model_name     String?
  prompt_text    String
  raw_output     String?
  report         Json?
  qa_findings    Json?
  state          ImportState @default(prompt_made)
  created_by     Int?
  created_at     DateTime    @default(now()) @db.Timestamptz(3)

  // Not in §4; needed to resume a half-finished batch (PRD §13.9, see DECISIONS.md).
  /// What the prompt was built for: level, chosen word codes, unit, kind, and so on.
  params     Json?
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  @@index([language, state])
  @@map("import_batch")
}

// ─────────────────────────────────────────────────────────────────────────────
// §4.2 Users
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                 Int       @id @default(autoincrement())
  /// Cleared when the account is deleted (PRD §15.5).
  phone              String?   @unique
  created_at         DateTime  @default(now()) @db.Timestamptz(3)
  session_length_min Int
  is_admin           Boolean   @default(false)
  admin_language     String?   @db.VarChar(8)
  is_tester          Boolean   @default(false)
  deleted_at         DateTime? @db.Timestamptz(3)

  auth_devices          AuthDevice[]
  enrollments           Enrollment[]
  skill_levels          SkillLevel[]
  item_states           ItemState[]
  confusion_pairs       ConfusionPair[]
  text_states           TextState[]
  phonics_states        PhonicsState[]
  sentence_drill_states SentenceDrillState[]
  speak_states          SpeakState[]
  dialogue_states       DialogueState[]
  errorfix_states       ErrorfixState[]
  writing_entries       WritingEntry[]
  notebook_entries      NotebookEntry[]
  new_word_queue        NewWordQueue[]
  daily_counters        DailyCounter[]
  sessions              Session[]
  review_logs           ReviewLog[]
  placement_runs        PlacementRun[]
  level_exams           LevelExam[]
  content_reports       ContentReport[]
  user_notices          UserNotice[]
  orders                Order[]
  subscriptions         Subscription[]

  @@map("user")
}

model OtpCode {
  id         Int        @id @default(autoincrement())
  phone      String
  code_hash  String
  purpose    OtpPurpose @default(login)
  expires_at DateTime   @db.Timestamptz(3)
  attempts   Int        @default(0)
  ip         String?
  created_at DateTime   @default(now()) @db.Timestamptz(3)

  // Not in §4; see DECISIONS.md.
  /// Set when the code is accepted, so it cannot be used twice.
  used_at   DateTime? @db.Timestamptz(3)
  /// Plain code, stored only by the mock SMS provider for the test-codes page (PRD §13.2).
  test_code String?

  @@index([phone, created_at])
  @@index([ip, created_at])
  @@map("otp_code")
}

model AuthDevice {

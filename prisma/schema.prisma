// ─────────────────────────────────────────────────────────────────────────────
// §4.3 Sales and administration
// ─────────────────────────────────────────────────────────────────────────────

model Plan {
  id            Int      @id @default(autoincrement())
  language      String   @db.VarChar(8)
  name_fa       String
  duration_days Int
  price_toman   Int
  badge_fa      String?
  module_codes  String[]
  sort_order    Int      @default(0)
  active        Boolean  @default(true)

  @@index([language, active, sort_order])
  @@map("plan")
}

model DiscountCode {
  id                Int          @id @default(autoincrement())
  /// Stored upper-case; lookups are case-insensitive (PRD §12.3).
  code              String       @unique
  type              DiscountType
  value             Int
  valid_from        DateTime?    @db.Timestamptz(3)
  valid_to          DateTime?    @db.Timestamptz(3)
  max_uses_total    Int?
  max_uses_per_user Int          @default(1)
  plan_ids          Int[]
  active            Boolean      @default(true)

  uses DiscountUse[]

  @@map("discount_code")
}

model DiscountUse {
  id       Int @id @default(autoincrement())
  code_id  Int
  user_id  Int
  order_id Int

  code DiscountCode @relation(fields: [code_id], references: [id])

  @@unique([order_id])
  @@index([code_id, user_id])
  @@map("discount_use")
}

model Order {
  id               Int         @id @default(autoincrement())
  user_id          Int
  plan_id          Int
  language         String      @db.VarChar(8)
  amount_toman     Int
  discount_code_id Int?
  final_amount     Int
  status           OrderStatus @default(pending)
  gateway          String
  authority        String?
  gateway_ref      String?
  created_at       DateTime    @default(now()) @db.Timestamptz(3)
  paid_at          DateTime?   @db.Timestamptz(3)
  last_verify_at   DateTime?   @db.Timestamptz(3)

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([status, created_at])
  @@map("order")
}

model Subscription {
  id         Int                @id @default(autoincrement())
  user_id    Int
  language   String             @db.VarChar(8)
  plan_id    Int?
  starts_at  DateTime           @db.Timestamptz(3)
  ends_at    DateTime           @db.Timestamptz(3)
  source     SubscriptionSource
  order_id   Int?
  granted_by Int?
  note       String?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, language, ends_at])
  @@map("subscription")
}

model TrialLedger {
  id         Int      @id @default(autoincrement())
  phone_hash String
  language   String   @db.VarChar(8)
  started_at DateTime @default(now()) @db.Timestamptz(3)

  @@unique([phone_hash, language])
  @@map("trial_ledger")
}

model EngineSetting {
  key            String   @id
  value          Json
  default_value  Json
  min_value      Float?
  max_value      Float?
  description_fa String
  updated_by     Int?
  updated_at     DateTime @updatedAt @db.Timestamptz(3)

  @@map("engine_setting")
}

model AppSetting {
  key        String   @id
  value      Json
  updated_by Int?
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  @@map("app_setting")
}

model AdminLog {
  id        Int      @id @default(autoincrement())
  admin_id  Int?
  action    String
  entity    String
  entity_id String?
  before    Json?
  after     Json?
  ts        DateTime @default(now()) @db.Timestamptz(3)

  @@index([entity, entity_id, ts])
  @@index([ts])
  @@map("admin_log")
}

model ErrorLog {
  /// Short readable code the owner can copy, e.g. E7K2QF.
  id         String   @id
  ts         DateTime @default(now()) @db.Timestamptz(3)
  where      String
  message    String
  stack      String?
  user_id    Int?
  request_id String?

  @@index([ts])
  @@map("error_log")
}

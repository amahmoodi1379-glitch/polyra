  user_id            Int
  refresh_token_hash String   @unique
  user_agent         String?
  last_seen_at       DateTime @default(now()) @db.Timestamptz(3)

  // Not in §4; see DECISIONS.md.
  created_at DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("auth_device")
}

model Enrollment {
  id                   Int        @id @default(autoincrement())
  user_id              Int
  language             String     @db.VarChar(8)
  created_at           DateTime   @default(now()) @db.Timestamptz(3)
  trial_started_at     DateTime?  @db.Timestamptz(3)
  trial_ends_at        DateTime?  @db.Timestamptz(3)
  start_mode           StartMode?
  placement_done       Boolean    @default(false)
  phonics_auto         Boolean    @default(false)
  phonics_done         Boolean    @default(false)
  phonics_skips        Int        @default(0)
  last_spread_date     DateTime?  @db.Date
  pace_mode            PaceMode   @default(normal)
  pretest_mode         Boolean    @default(false)
  streak_count         Int        @default(0)
  streak_last_date     DateTime?  @db.Date
  /// Tehran date of the week (Saturday) whose forgiveness day is used.
  streak_forgiven_week DateTime?  @db.Date
  freeze_count         Int        @default(0)
  freeze_checked_week  DateTime?  @db.Date
  leveldown_asked_at   DateTime?  @db.Timestamptz(3)
  shorten_asked_at     DateTime?  @db.Timestamptz(3)
  longer_asked_at      DateTime?  @db.Timestamptz(3)
  text_prompt_date     DateTime?  @db.Date
  install_prompt_count Int        @default(0)
  writing_done_week    DateTime?  @db.Date
  path_done_at         DateTime?  @db.Timestamptz(3)

  // Not in §4; see DECISIONS.md.
  /// Forgiveness days used in `streak_forgiven_week`, for `streak.forgive_per_week` above 1 (PRD §3.9).
  streak_forgiven_count Int @default(0)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, language])
  @@map("enrollment")
}

model SkillLevel {

  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one main action of a screen, in the sticky bottom block.",
      "html": "<button class=\"ds-btn-primary\">یاد گرفتم، برو تمرین</button>",
      "css": ".ds-btn-primary{min-height:58px;width:100%;padding:0 24px;border:0;border-radius:20px;font:800 16px/1 Vazirmatn,Tahoma,sans-serif;color:#fff;background:linear-gradient(180deg,#F0527F -40%,#D81E5B 55%,#A8134A 140%);box-shadow:0 10px 22px -10px rgba(216,30,91,.6),inset 0 1px 0 rgba(255,255,255,.38),inset 0 -2px 0 rgba(120,8,48,.25);cursor:pointer;transition:filter .2s,transform .2s} .ds-btn-primary:hover{filter:brightness(1.05)} .ds-btn-primary:active{transform:scale(1.03,.94)} .ds-btn-primary:focus-visible{outline:2px solid #F0527F;outline-offset:3px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "A real but lesser action, such as skipping a level.",
      "html": "<button class=\"ds-btn-secondary\">پرش از این سطح</button>",
      "css": ".ds-btn-secondary{min-height:54px;width:100%;border:0;border-radius:18px;background:#FDE7EF;color:#C21852;font:800 15px/1 Vazirmatn,Tahoma,sans-serif;cursor:pointer;transition:background-color .2s} .ds-btn-secondary:hover,.ds-btn-secondary:active{background:#F9D5E2} .ds-btn-secondary:focus-visible{outline:2px solid #F0527F;outline-offset:3px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "The quiet alternative under a primary button.",
      "html": "<button class=\"ds-btn-ghost\">این را بلدم</button>",
      "css": ".ds-btn-ghost{min-height:44px;padding:0 14px;border:0;border-radius:14px;background:none;color:#5E3F50;font:700 14px/1 Vazirmatn,Tahoma,sans-serif;cursor:pointer} .ds-btn-ghost:hover,.ds-btn-ghost:active{background:#FDE7EF;color:#2B1020} .ds-btn-ghost:focus-visible{outline:2px solid #F0527F;outline-offset:3px}"
    },
    {
      "name": "Level Chip",
      "kind": "chip",
      "refersTo": "chip-level",
      "description": "The learner's overall level in the top bar.",
      "html": "<span class=\"ds-chip-level\">A2</span>",
      "css": ".ds-chip-level{display:inline-grid;place-items:center;min-width:38px;height:28px;padding:0 8px;border-radius:10px;background:#FDE7EF;color:#C21852;font:600 15px/1 Fraunces,Georgia,serif;font-variation-settings:'SOFT' 100}"
    },
    {
      "name": "Skill Card",
      "kind": "card",
      "refersTo": "card",
      "description": "One of the four skills on home: duotone icon, name, level, progress.",
      "html": "<button class=\"ds-skill\"><svg viewBox=\"0 0 24 24\" width=\"34\" height=\"34\"><path fill=\"#D81E5B\" d=\"M9.4 3H18.6A2.4 2.4 0 0 1 21 5.4V14.6A2.4 2.4 0 0 1 18.6 17H18.2V5.8H7V5.4A2.4 2.4 0 0 1 9.4 3Z\"/><rect x=\"3\" y=\"7\" width=\"14\" height=\"14\" rx=\"2.4\" fill=\"#FBDCE7\" stroke=\"#D81E5B\" stroke-width=\"1.1\"/></svg><span class=\"ds-skill-nm\">واژگان</span><span class=\"ds-skill-lv\">A2</span><span class=\"ds-bar\"><i style=\"width:60%\"></i></span></button>",
      "css": ".ds-skill{width:92px;display:flex;flex-direction:column;align-items:center;gap:6px;padding:20px 4px 16px;border:0;border-radius:22px;background:#fff;color:#2B1020;box-shadow:0 1px 2px rgba(43,16,32,.05),0 10px 26px -14px rgba(120,20,60,.28);cursor:pointer;transition:transform .25s cubic-bezier(.16,1,.3,1)} .ds-skill:active{transform:scale(.95)} .ds-skill:focus-visible{outline:2px solid #F0527F;outline-offset:3px} .ds-skill-nm{font:700 12.5px/1.3 Vazirmatn,Tahoma,sans-serif} .ds-skill-lv{font:600 18px/1 Fraunces,Georgia,serif;font-variation-settings:'SOFT' 100} .ds-bar{width:64%;height:6px;border-radius:3px;background:#FDE7EF;position:relative;overflow:hidden} .ds-bar i{position:absolute;inset-block:0;inset-inline-start:0;border-radius:3px;background:linear-gradient(90deg,#F0527F,#D81E5B)}"
    },
    {
      "name": "Answer Option",
      "kind": "custom",
      "refersTo": "answer-option",
      "description": "A choice in an exercise; turns teal when right and deep raspberry when wrong.",
      "html": "<div class=\"ds-opts\"><button class=\"ds-opt ds-opt-wrong\">plage</button><button class=\"ds-opt ds-opt-ok\">gare</button><button class=\"ds-opt\">banque</button></div>",
      "css": ".ds-opts{display:grid;grid-template-columns:repeat(2,140px);gap:10px} .ds-opt{min-height:76px;border:0;border-radius:20px;background:#fff;color:#2B1020;font:500 24px/1 Fraunces,Georgia,serif;font-variation-settings:'SOFT' 100,'opsz' 36;box-shadow:0 1px 2px rgba(43,16,32,.05),0 10px 26px -14px rgba(120,20,60,.28),inset 0 0 0 1px #F0DDE5;cursor:pointer;transition:background-color .25s,box-shadow .25s} .ds-opt:hover{box-shadow:0 1px 2px rgba(43,16,32,.05),0 10px 26px -14px rgba(120,20,60,.28),inset 0 0 0 1px #E2C4D1} .ds-opt:focus-visible{outline:2px solid #F0527F;outline-offset:3px} .ds-opt-ok{background:#DDF5F2;color:#0E8077;box-shadow:inset 0 0 0 2px #1FB5A8} .ds-opt-wrong{background:#FBE0EA;color:#A8134A;box-shadow:inset 0 0 0 2px #A8134A}"

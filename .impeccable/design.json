      "html": "<label class=\"ds-switch\"><input type=\"checkbox\" checked><i></i></label>",
      "css": ".ds-switch{position:relative;display:inline-block;width:52px;height:32px} .ds-switch input{position:absolute;inset:0;opacity:0;margin:0;cursor:pointer} .ds-switch i{position:absolute;inset:0;border-radius:16px;background:#E2C4D1;transition:background-color .25s;pointer-events:none} .ds-switch i::after{content:'';position:absolute;top:3px;left:3px;width:26px;height:26px;border-radius:50%;background:#fff;box-shadow:0 2px 5px rgba(43,16,32,.25);transition:transform .45s cubic-bezier(.34,1.56,.64,1)} .ds-switch input:checked+i{background:#D81E5B} .ds-switch input:checked+i::after{transform:translateX(20px)} .ds-switch input:focus-visible+i{outline:2px solid #F0527F;outline-offset:2px}"

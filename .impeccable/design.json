      "html": "<div class=\"ds-seg\"><button class=\"ds-seg-on\">خودکار</button><button>روز</button><button>شب</button></div>",
      "css": ".ds-seg{display:grid;grid-template-columns:repeat(3,96px);gap:4px;padding:4px;border-radius:16px;background:#FDE7EF} .ds-seg button{min-height:42px;border:0;border-radius:12px;background:none;color:#5E3F50;font:700 14px/1 Vazirmatn,Tahoma,sans-serif;cursor:pointer;transition:background-color .2s,color .2s} .ds-seg button:hover{color:#2B1020} .ds-seg button:focus-visible{outline:2px solid #F0527F;outline-offset:-2px} .ds-seg .ds-seg-on{background:#fff;color:#C21852;box-shadow:0 2px 8px -3px rgba(120,20,60,.35)}"
